# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production on the target host and restrict permissions: chmod 600 .env.production
# ==============================================================================

# Application & Model Release Versions
APP_VERSION=v1.0.0
MODEL_VERSION=model_v1.0.0

# Database Credentials
POSTGRES_USER=pd_admin
POSTGRES_PASSWORD=replace_with_secure_64_char_password
POSTGRES_DB=pd_voice_prod

# LLM API Secret Key (RAG Clinical Synthesis)
ANTHROPIC_API_KEY=sk-ant-prod-your-api-key-here

# Persistent Paths
VECTOR_DB_PATH=/app/chroma_db

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["https://app.pdvoice.internal","https://pdvoice.hospital.org"]

# Observability
LOG_LEVEL=INFO
